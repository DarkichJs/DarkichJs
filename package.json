{
  "name": "readme-motion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Animated GitHub profile README generator powered by Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "fetch": "tsx scripts/fetch-data.ts",
    "render": "tsx scripts/render.ts",
    "readme": "tsx scripts/readme.ts",
    "build": "tsx scripts/build.ts",
    "test": "tsx --test scripts/*.test.ts",
    "typecheck": "tsc --noEmit",
    "preview": "tsx scripts/preview.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.2",
    "react-dom": "19.2",
    "remotion": "4.0.534",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "19.2",
    "puppeteer-core": "^24.43.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
