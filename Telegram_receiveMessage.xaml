      <InvokeCode.Code>
        <![CDATA[' Telegram Message Receiver with afterMessageID support
Dim shouldStop As Boolean = False
Dim messageFound As Boolean = False
Dim targetAfterID As Integer = 0

' Parse afterMessageID to integer for comparison
If Not String.IsNullOrEmpty(afterMessageID) Then
    Integer.TryParse(afterMessageID, targetAfterID)
    Console.WriteLine($"Looking for messages after ID: {targetAfterID}")
Else
    Console.WriteLine("No afterMessageID provided, will capture first message")
End If

' Outer polling loop
While Not shouldStop
    Try
        ' Simulate getting messages from Telegram client
        ' In real implementation, this would use the actual Telegram API
        ' For demo purposes, create sample messages
        Dim sampleMessages As Object() = {
            New With {.ID = 286, .Text = "Previous message"},
            New With {.ID = 287, .Text = "The trigger message"},
            New With {.ID = 288, .Text = "First message after trigger"},
            New With {.ID = 289, .Text = "Another message"}
        }
        
        If sampleMessages IsNot Nothing AndAlso sampleMessages.Length > 0 Then
            ' Inner loop to process messages
            For Each message As Object In sampleMessages
                ' Extract message ID and text
                Dim messageID As Integer = CInt(message.ID)
                Dim messageText As String = CStr(message.Text)
                
                Console.WriteLine($"Processing message ID: {messageID}")
                
                ' Check if we should process this message
                If String.IsNullOrEmpty(afterMessageID) Then
                    ' No afterMessageID specified, capture first message
                    lastMessage = messageText
                    messageFound = True
                    shouldStop = True
                    Console.WriteLine($"Captured first message: {messageText}")
                    Exit For
                ElseIf messageID > targetAfterID Then
                    ' Found message with ID greater than afterMessageID
                    lastMessage = messageText
                    messageFound = True
                    shouldStop = True
                    Console.WriteLine($"Found message after ID {targetAfterID}: Message ID {messageID} - {messageText}")
                    Exit For
                End If
            Next
        End If
        
        ' If we found the message, break from outer loop
        If shouldStop Then
            Exit While
        End If
        
        ' Wait before polling again (simulate polling interval)
        System.Threading.Thread.Sleep(1000)
        
    Catch ex As Exception
        Console.WriteLine($"Error in message polling: {ex.Message}")
        ' Continue polling on error, but could be modified to stop on certain errors
    End Try
End While

' Log termination reason
If messageFound Then
    Console.WriteLine("Message receiver terminated: Target message found and captured")
Else
    Console.WriteLine("Message receiver terminated: No matching message found")
End If]]>
      </InvokeCode.Code>
